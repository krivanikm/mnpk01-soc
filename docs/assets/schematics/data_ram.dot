digraph "data_ram" {
label="data_ram";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="addr", color="black", fontcolor="black"];
n3 [ shape=octagon, label="clk", color="black", fontcolor="black"];
n4 [ shape=octagon, label="din", color="black", fontcolor="black"];
n5 [ shape=octagon, label="dout", color="black", fontcolor="black"];
n6 [ shape=octagon, label="we", color="black", fontcolor="black"];
{ rank="source"; n2; n3; n4; n6;}
{ rank="sink"; n5;}
c10 [ shape=record, label="{{<p7> CLK|<p8> D}|$759\n$dff|{<p9> Q}}",  ];
v0 [ label="1'0" ];
v1 [ label="1'x" ];
v2 [ label="1'1" ];
v3 [ label="1'0" ];
c21 [ shape=record, label="{{<p11> RD_ADDR|<p12> RD_ARST|<p13> RD_CLK|<p14> RD_EN|<p15> RD_SRST|<p16> WR_ADDR|<p17> WR_CLK|<p18> WR_DATA|<p19> WR_EN}|mem\n$mem_v2|{<p20> RD_DATA}}",  ];
x4 [ shape=record, style=rounded, label="<s15> 16x 0:0 - 15:0 ", color="black", fontcolor="black" ];
x4:e -> c21:p19:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label="<16>"];
c21:p20:e -> c10:p8:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<16>"];
n2:e -> c21:p11:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<12>"];
n2:e -> c21:p16:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<12>"];
n3:e -> c10:p7:w [color="black", fontcolor="black", label=""];
n3:e -> c21:p17:w [color="black", fontcolor="black", label=""];
n4:e -> c21:p18:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<16>"];
c10:p9:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<16>"];
n6:e -> x4:s15:w [color="black", fontcolor="black", style="setlinewidth(3)", label="<16>"];
v0:e -> c21:p12:w [color="black", fontcolor="black", label=""];
v1:e -> c21:p13:w [color="black", fontcolor="black", label=""];
v2:e -> c21:p14:w [color="black", fontcolor="black", label=""];
v3:e -> c21:p15:w [color="black", fontcolor="black", label=""];
}
